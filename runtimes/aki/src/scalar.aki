// Little-endian scalar codecs and the f16 value type. Every reader takes the
// exact bytes of one element, so the same functions serve fixed-section
// scalars and the elements of a scalar list.
module nanobuf::scalar;

import {DecodeError} from nanobuf::error;
import {is_string_utf8} from akikit::text::code_point_validation;

// An IEEE 754 binary16 value, kept as its raw bit pattern. aki has no half
// type, so conversions go through f32; narrowing rounds to nearest, ties to
// even, like every other runtime. Equality compares bits: -0.0 != 0.0.
pub struct Float16 : Copy, Equal {
  pub var bits: u16 = 0;

  pub fn from_f32(v: f32): Float16;
  pub fn to_f32(self&): f32;
}

// Unsigned little-endian value of up to eight bytes.
pub fn le_bits(b: &[u8]): u64 {
  var v: u64 = 0;
  for (let i in 0..#b) {
    v |= (b[i] as u64) << (8 * i as u64);
  }
  return v;
}

pub fn read_u8(b: &[u8]): u8 => b[0];
pub fn read_u16(b: &[u8]): u16 => le_bits(b) as u16;
pub fn read_u32(b: &[u8]): u32 => le_bits(b) as u32;
pub fn read_u64(b: &[u8]): u64 => le_bits(b);
pub fn read_i8(b: &[u8]): i8 => @bit_cast(i8, b[0]);
pub fn read_i16(b: &[u8]): i16 => @bit_cast(i16, le_bits(b) as u16);
pub fn read_i32(b: &[u8]): i32 => @bit_cast(i32, le_bits(b) as u32);
pub fn read_i64(b: &[u8]): i64 => @bit_cast(i64, le_bits(b));
pub fn read_bool(b: &[u8]): bool => b[0] != 0;
pub fn read_f16(b: &[u8]): Float16 => Float16 { bits: le_bits(b) as u16 };
pub fn read_f32(b: &[u8]): f32 => @bit_cast(f32, le_bits(b) as u32);
pub fn read_f64(b: &[u8]): f64 => @bit_cast(f64, le_bits(b));

// Checks UTF-8 and views the bytes as text without copying them.
pub fn text_view<'a>(b: &'a [u8]): str<'a> ! DecodeError {
  if (!is_string_utf8(b as &[byte])) {
    return fail DecodeError::BadUtf8;
  }
  // The bytes were validated as UTF-8 just above, and the view borrows `b`
  // for `'a`, so the text is valid for as long as the caller may read it.
  return unsafe @str(@ptr(b) as *const c8, #b);
}

fn Float16::from_f32(v: f32): Float16 {
  let raw = @bit_cast(u32, v);
  let sign = ((raw >> 16) & 0x8000) as u16;
  let exp = ((raw >> 23) & 0xff) as i32;
  let frac = raw & 0x007fffff;

  if (exp == 255) {
    if (frac == 0) {
      return Float16 { bits: sign | 0x7c00 };
    }
    // NaN: keep the top payload bits and force the quiet bit, so the payload
    // can never read back as infinity.
    return Float16 { bits: sign | 0x7c00 | 0x0200 | (frac >> 13) as u16 };
  }
  let unbiased = exp - 127;
  if (unbiased >= 16) {
    return Float16 { bits: sign | 0x7c00 };
  }
  if (unbiased >= -14) {
    // Normal result: drop 13 fraction bits with round-to-nearest-even. A carry
    // out of the fraction bumps the exponent, which turns 65520.0 and up into
    // infinity.
    let half = (((unbiased + 15) as u32) << 10) | (frac >> 13);
    let dropped = frac & 0x1fff;
    var h = half;
    if (dropped > 0x1000 || (dropped == 0x1000 && (h & 1) != 0)) {
      h += 1;
    }
    return Float16 { bits: sign | (h as u16) };
  }
  if (unbiased >= -25 && exp != 0) {
    // Subnormal result; a round-up carry into bit 10 lands on the smallest
    // normal value, which is exactly right.
    let mantissa = frac | 0x00800000;
    let shift = (-1 - unbiased) as u32;
    let dropped = mantissa & ((1u32 << shift) - 1);
    let halfway = 1u32 << (shift - 1);
    var h = mantissa >> shift;
    if (dropped > halfway || (dropped == halfway && (h & 1) != 0)) {
      h += 1;
    }
    return Float16 { bits: sign | (h as u16) };
  }
  // Too small for binary16, including every f32 subnormal.
  return Float16 { bits: sign };
}

fn Float16::to_f32(self&): f32 {
  let bits = self.bits as u32;
  let sign = (bits & 0x8000) << 16;
  let exp = (bits >> 10) & 0x1f;
  let frac = bits & 0x03ff;
  var raw: u32 = 0;
  if (exp == 0) {
    if (frac == 0) {
      raw = sign;
    } else {
      // Subnormal: renormalize under the wider exponent. The top set bit of
      // the fraction becomes the implicit one.
      var p: u32 = 31;
      while ((frac & (1u32 << p)) == 0) {
        p -= 1;
      }
      raw = sign | ((103 + p) << 23) | ((frac << (23 - p)) & 0x007fffff);
    }
  } else if (exp == 31) {
    raw = sign | 0x7f800000 | (frac << 13);
  } else {
    raw = sign | ((exp + 112) << 23) | (frac << 13);
  }
  return @bit_cast(f32, raw);
}
